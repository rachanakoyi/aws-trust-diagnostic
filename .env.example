# ==============================================================
# AWS OBSERVATION TRUST & DIAGNOSTIC SYSTEM - CONFIGURATION
# ==============================================================

# Data Source Selection: 'imd' or 'fallback'
DATA_SOURCE=fallback

# Official IMD AWS API Configuration (Leave blank to trigger automatic fallback)
IMD_API_URL=
IMD_API_KEY=
IMD_API_TOKEN=

# Ingestion Polling Interval (in seconds)
# Set to 10 for interactive demonstration, 60 or 300 for real-world operations
POLL_INTERVAL_SECONDS=10

# Default Station Configuration
DEFAULT_STATION_ID=AWS_DELHI_001
DEFAULT_LATITUDE=28.585
DEFAULT_LONGITUDE=77.209

# Demo Mode Configuration
# When DEMO_MODE=true, interactive fault injection tools are enabled
DEMO_MODE=true

# Database Path
DB_PATH=database/app.db

# Physical Plausibility Limits
TEMP_MIN=-15.0
TEMP_MAX=55.0
PRESSURE_MIN=850.0
PRESSURE_MAX=1080.0
HUMIDITY_MIN=0.0
HUMIDITY_MAX=100.0

# Rate of Change Plausibility Limits (per 10-minute step equivalent)
MAX_TEMP_STEP_CHANGE=5.0
MAX_PRESSURE_STEP_CHANGE=6.0
MAX_HUMIDITY_STEP_CHANGE=25.0

# Persistence Detection (Number of identical consecutive readings)
PERSISTENCE_WINDOW=5
